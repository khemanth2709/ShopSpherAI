# Local SQLite database. The file is created automatically on first server start.
DATABASE_PATH=./data/shopsphere.sqlite

# Create the first administrator automatically. Change both values before starting.
ADMIN_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD_123

# Optional Openverse API application for higher photo-import limits.
# Register and verify an application at https://api.openverse.org/v1/ first.
# OPENVERSE_CLIENT_ID=
# OPENVERSE_CLIENT_SECRET=

# Optional transactional email for password resets and order updates.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=ShopSphere AI <orders@your-verified-domain.com>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional store/invoice display details.
NEXT_PUBLIC_STORE_NAME=ShopSphere AI
NEXT_PUBLIC_STORE_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_STORE_SUPPORT_PHONE=0000000000
NEXT_PUBLIC_STORE_ADDRESS=Update your business address before production launch

# Checkout currently supports Cash on Delivery only. No online-payment secret is required.
